load("//build_defs:cpp_opts.bzl", "COPTS")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# asio api
cc_library(
    name = "sync_api",
    srcs = [
        "sync_api.cpp",
        "sync_api.h",
    ],
    copts = COPTS,
    deps = [
        "@boost.asio",
        "@fmt",
    ],
)

cc_library(
    name = "async_api",
    srcs = [
        "async_api.cpp",
        "async_api.h",
    ],
    copts = COPTS,
    deps = [
        "@boost.asio",
        "@fmt",
    ],
)

# layering_check 要求每个 #include 都由直接 deps 提供,所以逐个 example 列自己实际用到的。
BINARIES = {
    # asio client
    "sync_client": [
        "//network",
        "@boost.asio",
        "@fmt",
        "@nlohmann_json//:json",
    ],
    "test_client_protobuf": [
        "//network",
        "//network/proto:msg_cc_proto",
        "@boost.asio",
        "@fmt",
    ],
    "test_client_json": [
        "//network",
        "@boost.asio",
        "@fmt",
        "@nlohmann_json//:json",
    ],
    "concurrency_client": [
        "//common",
        "//network",
        "@boost.asio",
        "@nlohmann_json//:json",
    ],

    # asio server
    "sync_server": [
        "@boost.asio",
        "@fmt",
    ],
    "async_io_service_pool_server": ["//network"],
    "async_thread_pool_server": ["//network"],
    "simple_coroutine_server": ["@boost.asio"],
    "coroutine_server": ["//network"],

    # beast http
    "http_client": [
        "@boost.asio",
        "@fmt",
    ],
    "http_server": [
        "@boost.asio",
        "@boost.beast",
        "@fmt",
        "@nlohmann_json//:json",
    ],
    "websocket_server": ["//network"],

    # grpc
    "grpc_server": [
        "//network/proto:greeter_cc_grpc",
        "@fmt",
        "@grpc//:grpc++",
    ],
    "grpc_client": [
        "//network/proto:greeter_cc_grpc",
        "@fmt",
        "@grpc//:grpc++",
    ],
    "grpc_concurrency_client": [
        "//common",
        "//network/proto:greeter_cc_grpc",
        "@fmt",
        "@grpc//:grpc++",
    ],
}

[cc_binary(
    name = binary,
    srcs = ["%s.cpp" % binary],
    copts = COPTS,
    deps = deps,
) for binary, deps in BINARIES.items()]
