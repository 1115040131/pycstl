load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(
    default_visibility = ["//visibility:public"],
)

# msg.pb
proto_library(
    name = "msg_proto",
    srcs = ["msg.proto"],
)

cc_proto_library(
    name = "msg_cc_proto",
    deps = ["msg_proto"],
)

# greeter.grpc
proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
)

cc_proto_library(
    name = "greeter_cc_proto",
    deps = ["greeter_proto"],
)

cc_grpc_library(
    name = "greeter_cc_grpc",
    srcs = ["greeter_proto"],
    grpc_only = True,
    deps = [
        "greeter_cc_proto",
        "@grpc//:grpc++",
    ],
)
