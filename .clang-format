BasedOnStyle: Google
# 访问说明符(public、private等)的偏移
AccessModifierOffset: -4
# 每行字符的限制，0表示没有限制
ColumnLimit: 115
# 继承最常用的指针和引用的对齐方式
DerivePointerAlignment: false
# 可以定义负数优先级从而保证某些#include永远在最前面
IncludeCategories:
  # 3. 第三方库
  - Regex: '^<(boost/|Eigen/|entt/|fmt/|gmock/|glm/|grpcpp/|gtest/|hiredis|imgui|mysqlx|nlohmann/|SDL|spdlog/|yaml-cpp|zlib)'
    Priority: 30

  # 3.1-3.3 Qt 头文件。CaseSensitive 保证 ^<Q[A-Z]...> 不误吃 <queue> 等小写标准库头;
  # 带 .h 的 Qt 头必须排在下方 C 标准库规则之前,否则会被 '^<.*\.' 截获。
  # Qt 具体头文件（如 QtCore/qstring.h）
  - Regex: '^<Qt[A-Z][a-zA-Z]*/.*\.h>'
    Priority: 30
    CaseSensitive: true
  # Qt 模块头文件（如 QtCore, QtWidgets）
  - Regex: '^<Qt[A-Z][a-zA-Z]*>'
    Priority: 30
    CaseSensitive: true
  # Qt 类头文件（如 QWidget, QString）
  - Regex: '^<Q[A-Z][a-zA-Z0-9]*>'
    Priority: 30
    CaseSensitive: true

  # 1. C 标准库
  - Regex: '^<.*\.'
    Priority: 10

  # 2. C++ 标准库
  - Regex: '^<'
    Priority: 20

  # finally other "" includes go between system headers and our headers
  - Regex: '^"'
    Priority: 40

IncludeIsMainRegex: '(Test)?$'
# 缩进宽度
IndentWidth: 4