load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "utils",
    hdrs = ["utils.h"],
    copts = COPTS,
    deps = [
        "@fmt",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "pycstl_all_test",
    srcs = glob(["*_test.cpp"]),
    copts = COPTS,
    features = [
        "cpp_modules",
        "-layering_check",
    ],
    deps = [
        ":utils",
        "//pycstl",
        "@fmt",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
