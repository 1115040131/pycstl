load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "noncopyable",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/noncopyable.cppm"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "allocator_wrapper",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/allocator_wrapper.cppm"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "connection_pool",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/connection_pool.cppm"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "string_hash",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/string_hash.cppm"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cin_redirect",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/cin_redirect.cppm"],
    visibility = ["//visibility:public"],
    deps = [":noncopyable"],
)

cc_library(
    name = "singleton",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/singleton.cppm"],
    visibility = ["//visibility:public"],
    deps = [":noncopyable"],
)

cc_library(
    name = "utils",
    srcs = ["src/utils.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/utils.cppm"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "timer",
    srcs = ["src/timer.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/timer.cppm"],
    visibility = ["//visibility:public"],
    deps = [
        ":utils",
        "@fmt",
    ],
)

# reflect.h 通篇是宏, 宏不能从模块导出, 故保持头文件形态
cc_library(
    name = "reflect",
    hdrs = ["include/common/reflect.h"],
    copts = COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

# json.h 依赖 reflect.h 的模板, 跟着一起留在头文件里
cc_library(
    name = "json",
    hdrs = ["include/common/json.h"],
    copts = COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":reflect",
        "@nlohmann_json//:json",
    ],
)
