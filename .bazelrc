#-------------------------------------------------------------------------------------
# Build configurations (use with --config=<name>)
#-------------------------------------------------------------------------------------

# Default compilation_mode is fastbuild; switch explicitly when you need -g or -O2
build:dbg --compilation_mode=dbg
build:opt --compilation_mode=opt

# CI 专用配置
common:ci --announce_rc
common:ci --color=yes
common:ci --lockfile_mode=error

build:ci --test_env=CO_ASYNC_TIMER_TOLERANCE_MS=20
build:ci --define=sdl3_console=true
build:ci --keep_going

test:ci --test_output=errors

#-------------------------------------------------------------------------------------
# Common settings
#-------------------------------------------------------------------------------------

# Auto-load build:linux / build:macos / build:windows sections based on current OS
common --enable_platform_specific_config

# Use prebuilt protoc instead of compiling from source (saves minutes)
common --@protobuf//bazel/flags:prefer_prebuilt_protoc

# Disable implicit __init__.py files creation
common --incompatible_default_to_explicit_init_py

#-------------------------------------------------------------------------------------
# C++ compilation
#-------------------------------------------------------------------------------------

# C++23 standard
build --cxxopt='-std=c++23'
build --host_cxxopt='-std=c++23'

# Verify parse_headers works as the toolchain changes
build --process_headers_in_dependencies

# Enable cpp_modules
build --experimental_cpp_modules

#-------------------------------------------------------------------------------------
# Third-party code: suppress warnings
#-------------------------------------------------------------------------------------

# Disable all warnings for external source files
build --per_file_copt=external/.*@-w
build --host_per_file_copt=external/.*@-w

# Use -isystem for external headers so the compiler ignores warnings from them
build --features=external_include_paths

#-------------------------------------------------------------------------------------
# Environment
#-------------------------------------------------------------------------------------

# Prefer local distdir for offline/slow-network builds
# build --distdir=/root/bazel-distdir

# build --local_resources=cpu=24

#-------------------------------------------------------------------------------------
# Coverage (LLVM toolchain)
#-------------------------------------------------------------------------------------

coverage --build_tests_only
coverage --combined_report=lcov
coverage --experimental_generate_llvm_lcov
coverage --instrumentation_filter=^//
coverage --nocache_test_results
coverage --per_file_copt=.*@-fprofile-continuous
coverage --test_env=LLVM_PROFILE_CONTINUOUS_MODE=1

#-------------------------------------------------------------------------------------
# Remote cache (BuildBuddy) — 用 --config=remote 启用, 本地默认不走
#
# endpoint 用 remote.buildbuddy.io(公共入口)。API key 不写进本文件: CI 从 secret 经
# 命令行传入, 本地要用就写在 .bazelrc.local:
#   common --remote_header=x-buildbuddy-api-key=<key>
#   common --noremote_upload_local_results   # 本地只读, 不把本机产物写回共享缓存
#-------------------------------------------------------------------------------------

# 构建事件上传, 可在 app.buildbuddy.io 上看缓存命中率与关键路径
common:remote --bes_results_url=https://app.buildbuddy.io/invocation/
common:remote --bes_backend=grpcs://remote.buildbuddy.io

common:remote --remote_cache=grpcs://remote.buildbuddy.io
common:remote --remote_timeout=10m

# 传输层优化, 取自 BuildBuddy 官方 shared.bazelrc 的 cache-shared 段
common:remote --remote_cache_compression
common:remote --experimental_remote_cache_chunking

# build 与 coverage 的产物基本无法互用(覆盖率给所有文件都加了插桩 flag), 用 instance
# name 在服务端分成两个互不可见的命名空间, 与 disk-cache 分两套的理由一致
common:remote-build --config=remote
common:remote-build --remote_instance_name=build

common:remote-coverage --config=remote
common:remote-coverage --remote_instance_name=coverage

#-------------------------------------------------------------------------------------
# Local overrides (not tracked by git)
#-------------------------------------------------------------------------------------

try-import %workspace%/.bazelrc.local