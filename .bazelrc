# Debug configuration
build:debug --compilation_mode=dbg

# Release configuration
build:release --compilation_mode=opt

# Fastbuild configuration (optional, as it is the default)
build:fastbuild --compilation_mode=fastbuild

common --enable_bzlmod
common --incompatible_disallow_empty_glob=false
common --enable_platform_specific_config
common --incompatible_autoload_externally=+@rules_cc,+@rules_python

common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
# common --per_file_copt=external/.*protobuf.*@--PROTOBUF_WAS_NOT_SUPPOSED_TO_BE_BUILT
# common --host_per_file_copt=external/.*protobuf.*@--PROTOBUF_WAS_NOT_SUPPOSED_TO_BE_BUILT
# common --per_file_copt=external/.*grpc.*@--GRPC_WAS_NOT_SUPPOSED_TO_BE_BUILT
# common --host_per_file_copt=external/.*grpc.*@--GRPC_WAS_NOT_SUPPOSED_TO_BE_BUILT

# For 3rd party code: Disable warnings entirely.
# They are not actionable and just create noise.
build --per_file_copt=external/.*@-w
build --host_per_file_copt=external/.*@-w

build --compilation_mode=dbg

# Minimium c++ standard used.
build --cxxopt='-std=c++20'
build --host_cxxopt='-std=c++20'