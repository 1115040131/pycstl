load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "chicken_evil_lib",
    srcs = glob(["chicken_evil/*.cpp"]),
    copts = COPTS,
    module_interfaces = glob(["chicken_evil/*.cppm"]),
    deps = [
        "//common:singleton",
        "//sdl2/common",
        "@eigen",
        "@fmt",
    ],
)

cc_binary(
    name = "chicken_evil",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob(["assets/**"]),
    deps = [":chicken_evil_lib"],
)
