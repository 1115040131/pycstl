    module_interfaces = glob(["src/**/*.cppm"]),
    visibility = ["//sdl2:__subpackages__"],
    deps = [
        "//sdl2",
        "//sdl2:sdl2_image",
        "//sdl2:sdl2_mixer",
        "//sdl2:sdl2_ttf",
        "@eigen",
        "@fmt",
