load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

cmake(
    name = "sdl2",
    build_args = ["-j8"],
    cache_entries = {"SDL_STATIC_ENABLED_BY_DEFAULT": "OFF"},
    # Point the hermetic pkg-config at the system pkgconfig dir so SDL's
    # pulse detection finds the host libpulse-dev. Without this only
    # dummy/disk audio backends are compiled in and SDL_Init(SDL_INIT_AUDIO)
    # fails with "No available audio device".
    env = {"PKG_CONFIG_PATH": "/usr/lib/x86_64-linux-gnu/pkgconfig"},
    generate_args = ["-GNinja"],
    # vendored 的 SDL2_image/SDL2_ttf 等上游头内部用引号引 "SDL.h",而 SDL.h 在
    # 另一个 cmake 输出目录下,必须把 include/SDL2 直接放进搜索路径。foreign_cc 的
    # cmake() 没有 strip_include_prefix,所以这里只能保留 includes。
    includes = ["SDL2"],
    lib_source = "@sdl2//:all_srcs",
    out_shared_libs = select({
        "//conditions:default": [
            "libSDL2-2.0.so",
            "libSDL2-2.0.so.0",
        ],
        "//:debug": [
            "libSDL2-2.0d.so",
            "libSDL2-2.0d.so.0",
        ],
    }),
    visibility = ["//sdl2:__subpackages__"],
)

cmake(
    name = "sdl2_image",
    build_args = ["-j8"],
    cache_entries = {
        "SDL2IMAGE_VENDORED": "ON",
        # Only PNG is used (decoded by the built-in stb backend). Disable the
        # heavy vendored codecs we don't need: AVIF pulls in aom/dav1d, plus TIF/WEBP.
        "SDL2IMAGE_AVIF": "OFF",
        "SDL2IMAGE_TIF": "OFF",
        "SDL2IMAGE_WEBP": "OFF",
    },
    generate_args = ["-GNinja"],
    lib_source = "@sdl2_image//:all_srcs",
    out_shared_libs = select({
        "//conditions:default": [
            "libSDL2_image-2.0.so",
            "libSDL2_image-2.0.so.0",
        ],
        "//:debug": [
            "libSDL2_image-2.0d.so",
            "libSDL2_image-2.0d.so.0",
        ],
    }),
    visibility = ["//sdl2:__subpackages__"],
    deps = ["sdl2"],
)

cmake(
    name = "sdl2_mixer",
    build_args = ["-j8"],
    cache_entries = {"SDL2MIXER_VENDORED": "ON"},
    generate_args = ["-GNinja"],
    lib_source = "@sdl2_mixer//:all_srcs",
    out_shared_libs = select({
        "//conditions:default": [
            "libSDL2_mixer-2.0.so",
            "libSDL2_mixer-2.0.so.0",
        ],
        "//:debug": [
            "libSDL2_mixer-2.0d.so",
            "libSDL2_mixer-2.0d.so.0",
        ],
    }),
    visibility = ["//sdl2:__subpackages__"],
    deps = ["sdl2"],
)

cmake(
    name = "sdl2_ttf",
    build_args = ["-j8"],
    cache_entries = {"SDL2TTF_VENDORED": "ON"},
    generate_args = ["-GNinja"],
    lib_source = "@sdl2_ttf//:all_srcs",
    out_shared_libs = select({
        "//conditions:default": [
            "libSDL2_ttf-2.0.so",
            "libSDL2_ttf-2.0.so.0",
        ],
        "//:debug": [
            "libSDL2_ttf-2.0d.so",
            "libSDL2_ttf-2.0d.so.0",
        ],
    }),
    visibility = ["//sdl2:__subpackages__"],
    deps = ["sdl2"],
)
