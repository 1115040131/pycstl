load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "tiny_db_lib",
    srcs = glob(["src/*.cpp"]),
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = glob(["src/*.cppm"]),
    deps = ["@fmt"],
)

cc_binary(
    name = "tiny_db",
    srcs = ["app/tiny_db.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    visibility = ["//tiny_db:__subpackages__"],
    deps = [
        ":tiny_db_lib",
        "@fmt",
    ],
)
