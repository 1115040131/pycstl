load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "tetris_lib",
    srcs = glob(["src/*.cpp"]),
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = glob(["src/*.cppm"]),
    deps = [
        "//common:singleton",
        "@fmt",
    ],
)

cc_binary(
    name = "tetris",
    srcs = ["app/tetris.cpp"],
    copts = COPTS,
    data = glob(["resource/**"]),
    features = ["cpp_modules"],
    deps = [":tetris_lib"],
)
