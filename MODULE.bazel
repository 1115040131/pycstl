"""c++ project build by bazel"""

module(
    name = "pycstl",
    version = "0.0.1",
)

_ALL_CONTENT = """\
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

#-------------------------------------------------------------------------------------
# C++
#-------------------------------------------------------------------------------------

# 1. The metadata of glog is fetched from the BCR, including its dependencies (gflags).
# 2. The `repo_name` attribute allows users to reference this dependency via the `gtest` repo name.
BOOST_VERSION = "1.90.0"

bazel_dep(name = "boost.asio", version = BOOST_VERSION + ".bcr.1")
bazel_dep(name = "boost.beast", version = BOOST_VERSION + ".bcr.1")
bazel_dep(name = "boost.property_tree", version = BOOST_VERSION + ".bcr.1")
bazel_dep(name = "boost.uuid", version = BOOST_VERSION + ".bcr.1")
bazel_dep(name = "eigen", version = "5.0.1.bcr.2")
bazel_dep(name = "fmt", version = "12.2.0")
bazel_dep(name = "gflags", version = "2.3.1")
bazel_dep(name = "glm", version = "1.0.3")
bazel_dep(name = "grpc", version = "1.83.0")
bazel_dep(name = "hiredis", version = "1.3.0")
bazel_dep(name = "imgui", version = "1.92.2")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")  # rules_qt need it
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "spdlog", version = "1.17.0")

# 第三方自己声明的 layering_check / parse_headers 会被 --process_headers_in_dependencies 一起
# 激活, 在这里统一关掉(原因、边界与维护方式写在被 include 的文件里)
include("//build_defs:third_party_hdr_check.MODULE.bazel")

# mysql-connector-cpp
bazel_dep(name = "mysql-connector-cpp")
local_path_override(
    module_name = "mysql-connector-cpp",
    path = "third_party/mysql-connector-cpp",
)

# imgui_backends
bazel_dep(name = "imgui_backends")
local_path_override(
    module_name = "imgui_backends",
    path = "third_party/imgui/backends",
)

bazel_dep(name = "toolchains_llvm", version = "1.8.0")

# Configure and register the toolchain.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "21.1.8",
    stdlib = {"linux-x86_64": "stdc++"},
)
use_repo(llvm, "llvm_toolchain")
# use_repo(llvm, "llvm_toolchain_llvm") # if you depend on specific tools in scripts

register_toolchains("@llvm_toolchain//:all")

