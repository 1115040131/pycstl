load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "ziyu_engine",
    srcs = glob(["monster_war/engine/**/*.cpp"]),
    hdrs = glob(["monster_war/engine/**/*.h"]),
    copts = COPTS,
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    features = ["-layering_check"],
    strip_include_prefix = "/sdl3/monster_war",
    deps = [
        "//common:noncopyable",
        "//common:string_hash",
        "//sdl3",
        "//sdl3:sdl3_image",
        "//sdl3:sdl3_mixer",
        "//sdl3:sdl3_ttf",
        "@entt",
        "@glm",
        "@imgui",
        "@imgui_backends//:platform-sdl3",
        "@imgui_backends//:renderer-sdlrenderer3",
        "@nlohmann_json//:json",
        "@spdlog",
    ],
)

cc_library(
    name = "monster_war_game",
    srcs = glob(["monster_war/game/**/*.cpp"]),
    hdrs = glob(["monster_war/game/**/*.h"]),
    copts = COPTS,
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    features = ["-layering_check"],
    strip_include_prefix = "/sdl3/monster_war",
    deps = [
        ":ziyu_engine",
        "@entt",
        "@glm",
        "@imgui",
        "@imgui_backends//:platform-sdl3",
        "@imgui_backends//:renderer-sdlrenderer3",
        "@nlohmann_json//:json",
        "@spdlog",
    ],
)

cc_binary(
    name = "monster_war",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob(["assets/**"]),
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    deps = [
        ":monster_war_game",
        ":ziyu_engine",
        "@bazel_tools//tools/cpp/runfiles",
        "@entt",
        "@spdlog",
    ],
)
