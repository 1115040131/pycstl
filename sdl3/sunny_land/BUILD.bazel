load("//build_defs:cpp_opts.bzl", "COPTS")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(features = ["-layering_check"])

cc_library(
    name = "ziyu_engine",
    srcs = glob(["sunny_land/engine/**/*.cpp"]),
    hdrs = glob(["sunny_land/engine/**/*.h"]),
    copts = COPTS,
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    includes = [""],
    deps = [
        "//common",
        "//sdl3",
        "//sdl3:sdl3_image",
        "//sdl3:sdl3_mixer",
        "//sdl3:sdl3_ttf",
        "@glm",
        "@nlohmann_json//:json",
        "@spdlog",
    ],
)

cc_binary(
    name = "sunny_land",
    srcs = glob([
        "sunny_land/game/**/*.cpp",
        "sunny_land/game/**/*.h",
    ]) + ["sunny_land/main.cpp"],
    copts = COPTS,
    data = glob(["assets/**"]),
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    deps = [
        "ziyu_engine",
        "@bazel_tools//tools/cpp/runfiles",
    ],
)
