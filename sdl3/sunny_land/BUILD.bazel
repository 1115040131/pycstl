load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "ziyu_engine",
    srcs = glob(["sunny_land/engine/**/*.cpp"]),
    copts = COPTS,
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    features = ["cpp_modules"],
    module_interfaces = glob(["sunny_land/engine/**/*.cppm"]),
    deps = [
        "//common:noncopyable",
        "//common:string_hash",
        "//sdl3",
        "//sdl3:sdl3_image",
        "//sdl3:sdl3_mixer",
        "//sdl3:sdl3_ttf",
        "@fmt",
        "@glm",
        "@nlohmann_json//:json",
        "@spdlog",
    ],
)

cc_library(
    name = "sunny_land_game",
    srcs = glob(["sunny_land/game/**/*.cpp"]),
    copts = COPTS,
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    features = ["cpp_modules"],
    module_interfaces = glob(["sunny_land/game/**/*.cppm"]),
    deps = [
        ":ziyu_engine",
        "//common:noncopyable",
        "@fmt",
        "@glm",
        "@nlohmann_json//:json",
        "@spdlog",
    ],
)

cc_binary(
    name = "sunny_land",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob(["assets/**"]),
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    features = ["cpp_modules"],
    deps = [
        ":sunny_land_game",
        ":ziyu_engine",
        "@bazel_tools//tools/cpp/runfiles",
        "@spdlog",
    ],
)
