load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

# sdl3
cmake(
    name = "sdl3",
    build_args = ["-j8"],
    generate_args = ["-GNinja"],
    lib_source = "@sdl3//:all_srcs",
    out_shared_libs = [
        "libSDL3.so",
        "libSDL3.so.0",
    ],
    visibility = ["//visibility:public"],
)

cmake(
    name = "sdl3_image",
    build_args = ["-j8"],
    # build_data (not data) puts nasm in the exec config, which builds it in opt.
    # The dbg (-O0) build segfaults assembling aom asm; opt is safe.
    build_data = ["@nasm"],
    cache_entries = {
        "SDLIMAGE_VENDORED": "ON",
        # dav1d's mem.h uses posix_memalign; its meson build defines _GNU_SOURCE on
        # linux, but the vendored CMake port omits it. Match meson here.
        "CMAKE_C_FLAGS": "-D_GNU_SOURCE",
    },
    env = {
        "ASM_NASM": "$(execpath @nasm)",
        "NASM_PATH": "$(execpath @nasm)/..",
    },
    generate_args = ["-GNinja"],
    lib_source = "@sdl3_image//:all_srcs",
    out_shared_libs = [
        "libSDL3_image.so",
        "libSDL3_image.so.0",
    ],
    visibility = ["//visibility:public"],
    deps = ["sdl3"],
)

cmake(
    name = "sdl3_mixer",
    build_args = ["-j8"],
    cache_entries = {
        "SDLMIXER_VENDORED": "ON",
        "SDLMIXER_MIDI_NATIVE": "OFF",
    },
    generate_args = ["-GNinja"],
    lib_source = "@sdl3_mixer//:all_srcs",
    out_shared_libs = [
        "libSDL3_mixer.so",
        "libSDL3_mixer.so.0",
    ],
    visibility = ["//visibility:public"],
    deps = ["sdl3"],
)

cmake(
    name = "sdl3_ttf",
    build_args = ["-j8"],
    cache_entries = {"SDLTTF_VENDORED": "ON"},
    generate_args = ["-GNinja"],
    lib_source = "@sdl3_ttf//:all_srcs",
    out_shared_libs = [
        "libSDL3_ttf.so",
        "libSDL3_ttf.so.0",
    ],
    visibility = ["//visibility:public"],
    deps = ["sdl3"],
)
