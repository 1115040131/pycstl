    name = "ghost_escape",
    srcs = glob([
        "ghost_escape/**/*.cpp",
        "ghost_escape/**/*.h",
    ]),
    copts = COPTS,
    data = glob(["assets/**"]),
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    features = ["-layering_check"],
    includes = ["."],
    deps = [
        "//common:singleton",
        "//sdl3",
        "//sdl3:sdl3_image",
        "//sdl3:sdl3_mixer",
        "//sdl3:sdl3_ttf",
        "@fmt",
        "@glm",
    ],
)
