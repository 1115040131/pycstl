load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "ghost_escape_lib",
    srcs = glob(["ghost_escape/**/*.cpp"]),
    hdrs = glob(["ghost_escape/**/*.h"]),
    copts = COPTS,
    defines = select({
        "//conditions:default": [],
        "//:debug": ["DEBUG_MODE"],
    }),
    features = ["-layering_check"],
    strip_include_prefix = "/sdl3/ghost_escape",
    deps = [
        "//common:singleton",
        "//sdl3",
        "//sdl3:sdl3_image",
        "//sdl3:sdl3_mixer",
        "//sdl3:sdl3_ttf",
        "@fmt",
        "@glm",
    ],
)

cc_binary(
    name = "ghost_escape",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob(["assets/**"]),
    deps = [":ghost_escape_lib"],
)
