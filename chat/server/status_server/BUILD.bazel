load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "status_server_lib",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    copts = COPTS,
    includes = ["include"],
    deps = [
        "//chat/common",
        "//chat/server/common",
        "//chat/server/proto:status_cc_grpc_proto",
        "//logger",
        "@fmt",
        "@grpc//:grpc++",
    ],
)

cc_binary(
    name = "status_server",
    srcs = ["status_server.cpp"],
    copts = COPTS,
    deps = [
        ":status_server_lib",
        "//chat/server/common",
        "@boost.asio",
    ],
)
