load("@pycstl_deps//:requirements.bzl", "requirement")
load("@rules_python//python:py_test.bzl", "py_test")

# test
py_test(
    name = "run_all_test",
    srcs = [
        "chat_server_test.py",
        "gate_server_test.py",
        "run_all_test.py",
        "status_server_test.py",
        "test_define.py",
    ],
    data = [
        "//chat/server/chat_server",
        "//chat/server/gate_server",
        "//chat/server/status_server",
    ],
    imports = ["."],
    deps = [
        requirement("mysql-connector-python"),
        requirement("redis"),
        requirement("requests"),
        # status_py_grpc (grpc's rule) does not forward the protobuf python runtime
        # from its proto dep, so depend on status_py_proto directly to pull it in.
        "//chat/server/proto:status_py_proto",
        "//chat/server/proto:status_py_grpc",
    ],
)
