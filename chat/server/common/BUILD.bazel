load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

package(default_visibility = ["//chat/server:__subpackages__"])

# Header-only utilities ---------------------------------------------------------

cc_library(
    name = "defer",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/defer.cppm"],
)

cc_library(
    name = "data",
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/data.cppm"],
    deps = ["@nlohmann_json//:json"],
)

cc_library(
    name = "utils",
    srcs = ["src/utils.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/utils.cppm"],
    deps = ["@boost.uuid"],
)

# Config ------------------------------------------------------------------------

cc_library(
    name = "config_mgr",
    srcs = ["src/config_mgr.cpp"],
    copts = COPTS,
    data = glob(["config/*"]),
    features = ["cpp_modules"],
    module_interfaces = ["src/config_mgr.cppm"],
    deps = [
        "//common:connection_pool",
        "//common:singleton",
        "//common:utils",
        "//logger",
        "@boost.property_tree",
    ],
)

# Networking --------------------------------------------------------------------

cc_library(
    name = "io_service_pool",
    srcs = ["src/io_service_pool.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/io_service_pool.cppm"],
    deps = [
        "//common:connection_pool",
        "//common:singleton",
        "//common:utils",
        "//logger",
        "@boost.asio",
    ],
)

# MySQL -------------------------------------------------------------------------

cc_library(
    name = "mysql_pool",
    srcs = ["src/mysql_pool.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/mysql_pool.cppm"],
    deps = [
        ":defer",
        "//common:connection_pool",
        "//common:singleton",
        "//common:utils",
        "//logger",
        "@fmt",
        "@mysql-connector-cpp",
    ],
)

cc_library(
    name = "mysql_mgr",
    srcs = ["src/mysql_mgr.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/mysql_mgr.cppm"],
    deps = [
        ":config_mgr",
        ":data",
        ":defer",
        ":mysql_pool",
        "//common:connection_pool",
        "//common:singleton",
        "//common:utils",
        "//logger",
    ],
)

# Redis -------------------------------------------------------------------------

cc_library(
    name = "redis_connection_pool",
    srcs = ["src/redis_connection_pool.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/redis_connection_pool.cppm"],
    deps = [
        "//logger",
        "@hiredis",
    ],
)

cc_library(
    name = "redis_mgr",
    srcs = ["src/redis_mgr.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/redis_mgr.cppm"],
    deps = [
        ":config_mgr",
        ":redis_connection_pool",
        "//common:connection_pool",
        "//common:singleton",
        "//common:utils",
    ],
)

# gRPC client -------------------------------------------------------------------

cc_library(
    name = "status_grpc_client",
    srcs = ["src/status_grpc_client.cpp"],
    copts = COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/status_grpc_client.cppm"],
    deps = [
        ":config_mgr",
        ":defer",
        "//chat/common",
        "//chat/server/proto:status_cc_grpc_proto",
        "//chat/server/proto:status_cc_proto",
        "//common:connection_pool",
        "//common:singleton",
        "//common:utils",
        "@grpc//:grpc++",
    ],
)
