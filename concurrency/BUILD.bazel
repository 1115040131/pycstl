load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

cc_library(
    name = "concurrency",
    srcs = glob(["src/**/*.cpp"]),
    copts = COPTS,
    features = ["cpp_modules"],
    linkopts = ["-latomic"],
    module_interfaces = glob(["src/**/*.cppm"]),
    visibility = ["//concurrency:__subpackages__"],
    deps = [
        "//common:allocator_wrapper",
        "//common:noncopyable",
        "//common:singleton",
    ],
)
