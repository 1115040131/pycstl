    name = "concurrency",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/concurrency/**/*.h"]),
    copts = COPTS,
    includes = ["include"],
    linkopts = ["-latomic"],
    deps = [
        "//common:allocator_wrapper",
        "//common:noncopyable",
        "//common:singleton",
    ],
)
