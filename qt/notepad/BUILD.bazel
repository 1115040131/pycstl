load("@rules_qt//:qt.bzl", "qt_cc_binary", "qt_cc_library")
load("//build_defs:cpp_opts.bzl", "COPTS")

qt_cc_library(
    name = "notepad_lib",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    copts = COPTS,
    features = ["-layering_check"],
    strip_include_prefix = "include",
    deps = [
        "@rules_qt//:qt_widgets",
    ],
)

qt_cc_binary(
    name = "notepad",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob([
        "res/*",
    ]),
    features = ["-layering_check"],
    deps = [
        ":notepad_lib",
    ],
)
